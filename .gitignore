# Virtualenvs (huge, machine-specific — never commit)
venv/
venv-chatterbox/

# Python bytecode
__pycache__/
*.pyc

# Server logs (reboot.sh writes here) + any stray root logs
logs/
*.log

# Generated / streamed audio and scratch clips
scratch/

# Voice and chime assets. On this machine voices/ and chimes/ are symlinks to the
# Windows source (C:\Users\chris\tts\...), so drops there appear here instantly.
# Ignore them entirely — both the symlinks and any contents are machine-specific.
/voices
/chimes

# Ad-hoc voice reference backups (binary, machine-specific, same reasoning
# as voices/ above)
/voice-backups

# Local Claude Code tooling config (may contain machine-specific paths)
.claude/
